{
  "name": "@aevum/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:workspace-deps": "pnpm --filter @aevum/contracts build && pnpm --filter @aevum/sensor-simulator build",
    "prestart": "pnpm run build:workspace-deps",
    "start": "expo start",
    "prestart:dev-client": "pnpm run build:workspace-deps",
    "start:dev-client": "expo start --dev-client",
    "preandroid": "pnpm run build:workspace-deps",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "clean": "rimraf .expo"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.8.1",
    "@react-navigation/native": "^7.1.18",
    "@aevum/contracts": "workspace:*",
    "@aevum/sensor-simulator": "workspace:*",
    "expo": "~57.0.0",
    "expo-dev-client": "~57.0.12",
    "expo-sqlite": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3"
  }
}
